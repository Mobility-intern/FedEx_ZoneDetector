cat > .gitignore <<'EOF'
# Python
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Environment / secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Frontend
frontend/node_modules/
frontend/build/
frontend/.cache/

# Databases / local runtime files
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# IDE
.vscode/
.idea/
EOF